# Docker deployment config (copy as .env)
POJUN_TAG=latest
# Image name: defaults to ghcr.io/chu0119/pojun (amd64/arm64 multi-arch, published by CI per release)
# POJUN_IMAGE=ghcr.io/chu0119/pojun
POSTGRES_USER=pojun
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=pojun

# LLM (set one or both; can also be left empty and configured in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
POJUN_LLM_PROVIDER=
POJUN_LLM_MODEL=
POJUN_LLM_BASE_URL=
POJUN_LLM_PROXY=
