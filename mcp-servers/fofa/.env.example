# FOFA asset-mapping MCP config template (copy to .env; keys live only here, never in the repo/chat)
# official API primary account (auto-switches to backup on 429/rate limit)
FOFA_EMAIL=your_email@example.com
FOFA_KEY=your_fofa_api_key
# backup accounts (optional, multi-account rotation)
FOFA_EMAIL_BACKUP=
FOFA_KEY_BACKUP=
FOFA_EMAIL_BACKUP2=
FOFA_KEY_BACKUP2=
# one-fox community channel (optional: needs no own key; preferred when available — password below)
ONEFOX_PASSWORD=
